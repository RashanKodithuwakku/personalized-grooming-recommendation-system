# Component 3 backend environment example
# Copy to .env and adjust as needed. Paths may be absolute or relative to backend/.

LOG_LEVEL=INFO

# Artifact locations (defaults resolve relative to the backend/ directory)
MODELS_DIR=models
DATASETS_DIR=datasets
CATALOGUE_PATH=datasets/generated_data/style_catalogue.csv
SCHEMA_PATH=models/gender_aware_schema.json

# Recovered original weighted-rule parameters (preserved provenance file)
RULE_PARAMETERS_PATH=datasets/rating_parameters.json
# Full training_pairs.rating parity check during startup (recommended)
RULE_PARITY_CHECK_ON_STARTUP=true

# CORS allowlist for a future Flutter / web client (comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
# Loopback-only regex so Flutter web (random localhost port) can call the API.
# Set empty to disable. Does not allow arbitrary LAN origins.
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$
CORS_ALLOW_CREDENTIALS=false

# CatBoost inference threads (keep low to avoid oversubscription)
CATBOOST_THREAD_COUNT=1

# Recommendation limits
MAX_TOP_N=20
DEFAULT_TOP_N=5

# Provisional hybrid weights WITHOUT rule parameters (must sum to 1.0)
# These are engineering defaults, not research-validated weights.
WEIGHT_PREDICTED_COMPAT_NO_RULES=0.70
WEIGHT_RANK_PERCENTILE_NO_RULES=0.30

# Provisional hybrid weights WITH verified rule parameters (must sum to 1.0)
WEIGHT_PREDICTED_COMPAT_WITH_RULES=0.50
WEIGHT_RANK_PERCENTILE_WITH_RULES=0.30
WEIGHT_RULE_COMPAT_WITH_RULES=0.20

# Heuristic input-quality caution threshold (upstream confidence aggregate)
INPUT_QUALITY_CAUTION_THRESHOLD=0.60
LOW_CONFIDENCE_ATTRIBUTE_THRESHOLD=0.50
# Require full nine-attribute facial confidence coverage for "adequate"
INPUT_QUALITY_MIN_COVERAGE=1.0
