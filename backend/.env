# Component 4 backend settings
# Configure this only after installing official HairFastGAN and its pretrained weights
# in a compatible Linux + NVIDIA CUDA environment.
#
# Example official CLI command (run from the HairFastGAN repository root):
# HAIRFASTGAN_COMMAND=python main.py --face_path={input} --shape_path={reference} --color_path={reference} --input_dir=. --result_path={output}
# HAIRFASTGAN_WORKDIR=/path/to/HairFastGAN
#
# On Windows PowerShell, use setx only if the model is installed in a compatible
# environment; for WSL/Linux, set these variables in the backend service environment.
HAIRFASTGAN_COMMAND=
HAIRFASTGAN_WORKDIR=
HAIRFASTGAN_API_URL=https://banner-falling-psychiatry-george.trycloudflare.com
